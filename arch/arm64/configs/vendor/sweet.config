# Camera
CONFIG_LDO_WL2866D=y
CONFIG_SPECTRA_CAMERA_UPGRADE=y

# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_SWEET=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FS_TEE=y

# Haptics
CONFIG_INPUT_AW8624_HAPTIC=y
# CONFIG_LEDS_QPNP_HAPTICS is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# IR
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y
# CONFIG_IR_MSM_GENI is not set

# MMC
CONFIG_MMC=y
CONFIG_MMC_PERF_PROFILING=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_BLOCK_DEFERRED_RESUME=y
# CONFIG_MMC_TEST is not set
CONFIG_MMC_PARANOID_SD_INIT=y
CONFIG_MMC_CLKGATE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQ_HCI=y
CONFIG_MMC_CQ_HCI_CRYPTO=y
CONFIG_MMC_CQ_HCI_CRYPTO_QTI=y

# MIUI
CONFIG_MIGT=y
CONFIG_CJSON=y
CONFIG_HWCONF_MANAGER=y
CONFIG_PERF_CRITICAL_RT_TASK=y
CONFIG_SF_BINDER=y
CONFIG_BOOT_INFO=y
CONFIG_MI_MEMORY_SYSFS=y
CONFIG_MIUI_ZRAM_MEMORY_TRACKING=y
CONFIG_RTMM=y
CONFIG_SDCARD_FS=y
CONFIG_NETLABEL=y
CONFIG_XDP_SOCKETS=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_QCOM_DLOAD_MODE=y
CONFIG_RC_DECODERS=y
CONFIG_IR_LIRC_CODEC=y
CONFIG_IR_NEC_DECODER=y
CONFIG_IR_RC5_DECODER=y
CONFIG_IR_RC6_DECODER=y
CONFIG_IR_JVC_DECODER=y
CONFIG_IR_SONY_DECODER=y
CONFIG_IR_SANYO_DECODER=y
CONFIG_IR_SHARP_DECODER=y
CONFIG_IR_MCE_KBD_DECODER=y
CONFIG_IR_XMP_DECODER=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_MINIDUMP_MAX_ENTRIES=200
CONFIG_HAVE_FUNCTION_GRAPH_TRACER=y
CONFIG_SECURITY_SMACK=y
CONFIG_PCI_MSM_MSI=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_LOG_BUF_SHIFT=21
CONFIG_MSDOS_FS=y
CONFIG_CPU_BOOST=y
CONFIG_MSM_PERFORMANCE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_WANT_DEV_COREDUMP=y
CONFIG_DEV_COREDUMP=y
CONFIG_MEMORY_STATE_TIME=y
CONFIG_QPNP_MISC=y
CONFIG_HID_QVR=y
CONFIG_EXT4_ENCRYPTION=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FRAME_WARN=4096
CONFIG_PSTORE_LAST_KMSG=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_STATIC_USERMODEHELPER_PATH="/system/bin/micd"
CONFIG_FAKE_PROC_VERSION_STRING="Linux version 4.14.190-perf-g7da93debc0ee (builder@pangu-build-component-vendor-184490-m9bcb-rhc0d-0g9jx) (clang version 10.0.7 for Android NDK, GNU ld (binutils-2.27-bd24d23f) 2.27.0.20170315) #1 SMP PREEMPT Tue Nov 21 06:37:52 UTC 2023"
# CONFIG_SECURITY_SMACK_BRINGUP is not set
# CONFIG_SECURITY_SMACK_NETFILTER is not set
# CONFIG_SECURITY_SMACK_APPEND_SIGNALS is not set
# CONFIG_MSM_IDLE_STATS is not set
# CONFIG_NVM is not set
# CONFIG_QCA7000_UART is not set
# CONFIG_NET_ACT_BPF is not set
# CONFIG_NET_CLS_MATCHALL is not set
# CONFIG_NET_ACT_POLICE is not set
# CONFIG_NET_SCH_TBF is not set
# CONFIG_NET_SCH_NETEM is not set
# CONFIG_SUSPEND_SKIP_SYNC is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_XFRM_MIGRATE is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_REFCOUNT_FULL is not set
# CONFIG_WQ_POWER_EFFICIENT_DEFAULT is not set
# CONFIG_SCHED_STACK_END_CHECK is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set

# NFC
CONFIG_NFC_NQ_PN80T=y
# CONFIG_NFC_NQ is not set

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_CHARGER_LN8000=y
CONFIG_K6_CHARGE=y
CONFIG_ONEWIRE_GPIO=y
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M loglevel=8"

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX9896_I2C=y
CONFIG_TOUCHSCREEN_FTS_K6=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_NEW_TOUCH_GAMEMODE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# Tweaks
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=15
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_SCHED_BORE=y
CONFIG_SCHED_WALT=y
CONFIG_OPLUS_MM_HACKS=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_ROP_PROTECTION_NONE=y
CONFIG_BPF_LSM=y
CONFIG_FAKE_UNAME_NONE=y
# CONFIG_FAKE_UNAME_5_10 is not set
# CONFIG_FAKE_UNAME_5_4 is not set
# CONFIG_FAKE_UNAME_4_19 is not set
# CONFIG_FAKE_UNAME_5_15 is not set
# CONFIG_FAKE_UNAME_6_1 is not set
# CONFIG_FAKE_UNAME_6_6 is not set
# CONFIG_FAKE_UNAME_6_12 is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_KFENCE is not set
# CONFIG_KFENCE_SAMPLE_INTERVAL is not set
# CONFIG_KFENCE_NUM_OBJECTS is not set
# CONFIG_DEBUG_LIST is not set

# Ultrasound proxmity
CONFIG_US_PROXIMITY=y
