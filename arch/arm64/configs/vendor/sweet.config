# Camera
CONFIG_LDO_WL2866D=y
CONFIG_SPECTRA_CAMERA_UPGRADE=y

# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_SWEET=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FS_TEE=y

# Haptics
CONFIG_INPUT_AW8624_HAPTIC=y
# CONFIG_LEDS_QPNP_HAPTICS is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# IR
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y
# CONFIG_IR_MSM_GENI is not set

# MMC
CONFIG_MMC=y
CONFIG_MMC_PERF_PROFILING=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_BLOCK_DEFERRED_RESUME=y
# CONFIG_MMC_TEST is not set
CONFIG_MMC_PARANOID_SD_INIT=y
CONFIG_MMC_CLKGATE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQ_HCI=y
CONFIG_MMC_CQ_HCI_CRYPTO=y
CONFIG_MMC_CQ_HCI_CRYPTO_QTI=y

# MIUI
CONFIG_CJSON=y
CONFIG_HWCONF_MANAGER=y
CONFIG_PERF_CRITICAL_RT_TASK=y
CONFIG_SF_BINDER=y
CONFIG_BOOT_INFO=y
CONFIG_MI_MEMORY_SYSFS=y
CONFIG_MIUI_ZRAM_MEMORY_TRACKING=y
CONFIG_RTMM=y
CONFIG_SDCARD_FS=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_SQ=y
CONFIG_BLK_WBT_MQ=y
CONFIG_PCI_MSM_MSI=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CHR_DEV_SCH=y
CONFIG_LOG_BUF_SHIFT=21
CONFIG_MSDOS_FS=y
CONFIG_CPU_BOOST=y
CONFIG_MSM_PERFORMANCE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_WANT_DEV_COREDUMP=y
CONFIG_DEV_COREDUMP=y
CONFIG_MEMORY_STATE_TIME=y
CONFIG_QPNP_MISC=y
CONFIG_HID_QVR=y
CONFIG_IOMMU_DEBUG=y
CONFIG_IOMMU_DEBUG_TRACKING=y
CONFIG_IOMMU_TESTS=y
CONFIG_MSM_TZ_LOG=y
CONFIG_EXT4_ENCRYPTION=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_FRAME_WARN=4096
CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y
CONFIG_ARM64_PTDUMP_CORE=y
CONFIG_PID_IN_CONTEXTIDR=y
CONFIG_CORESIGHT=y
CONFIG_CORESIGHT_LINKS_AND_SINKS=y
CONFIG_CORESIGHT_LINK_AND_SINK_TMC=y
CONFIG_CORESIGHT_SOURCE_ETM4X=y
CONFIG_CORESIGHT_DYNAMIC_REPLICATOR=y
CONFIG_CORESIGHT_STM=y
CONFIG_CORESIGHT_CTI=y
CONFIG_CORESIGHT_OST=y
CONFIG_CORESIGHT_TPDA=y
CONFIG_CORESIGHT_TPDM=y
CONFIG_CORESIGHT_HWEVENT=y
CONFIG_CORESIGHT_DUMMY=y
CONFIG_CORESIGHT_REMOTE_ETM=y
CONFIG_CORESIGHT_REMOTE_ETM_DEFAULT_ENABLE=0
CONFIG_CORESIGHT_CSR=y
CONFIG_CORESIGHT_EVENT=y
CONFIG_PSTORE_LAST_KMSG=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_STATIC_USERMODEHELPER_PATH="/system/bin/micd"
# CONFIG_JUMP_LABEL is not set
# CONFIG_REFCOUNT_FULL is not set
# CONFIG_WQ_POWER_EFFICIENT_DEFAULT is not set
# CONFIG_SCHED_STACK_END_CHECK is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_CORESIGHT_CATU is not set
# CONFIG_CORESIGHT_SINK_TPIU is not set
# CONFIG_CORESIGHT_SINK_ETBV10 is not set
# CONFIG_CORESIGHT_DBGUI is not set
# CONFIG_CORESIGHT_TPDM_DEFAULT_ENABLE is not set
# CONFIG_CORESIGHT_QPDI is not set
# CONFIG_CORESIGHT_TGU is not set

# NFC
CONFIG_NFC_NQ_PN80T=y
# CONFIG_NFC_NQ is not set

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_CHARGER_LN8000=y
CONFIG_K6_CHARGE=y
CONFIG_ONEWIRE_GPIO=y
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX9896_I2C=y
CONFIG_TOUCHSCREEN_FTS_K6=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_NEW_TOUCH_GAMEMODE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# Tweaks
CONFIG_OPLUS_MM_HACKS=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_KFENCE is not set
# CONFIG_KFENCE_SAMPLE_INTERVAL is not set
# CONFIG_KFENCE_NUM_OBJECTS is not set

# Ultrasound proxmity
CONFIG_US_PROXIMITY=y
